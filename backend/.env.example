APP_NAME="InvoiceAI"
DEBUG=True
PORT=8000

# Database (Default: SQLite local database)
DATABASE_URL="sqlite:///./invoiceguard.db"

# Security
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / AI Engine Settings
LLM_PROVIDER="fallback" # Options: fallback, openai, gemini, ollama
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
